# Copy to .env (git-ignored) and fill in real values. All money limits are tiny by default.
EXECUTION_MODE=paper            # paper | live
NETWORK=testnet                 # testnet (Base Sepolia / 0G Galileo) | mainnet (Base / 0G)
GLOBAL_KILL_SWITCH=false
MAX_TRADE_USD=1
MAX_AGENT_ALLOCATION_USD=5
MAX_DAILY_VOLUME_USD_PER_AGENT=20
MAX_DAILY_LOSS_USD_PER_AGENT=1
MAX_OPEN_POSITIONS=2
ALLOWED_TOKENS=WETH,cbBTC
FLASH_INTEGRATOR_FEE_BPS=10
COMMISSION_BPS_DEFAULT=1000
FORK_PLATFORM_BPS=3000
AGENT_DAILY_0G_CAP=1
RESERVE_DAYS=3
MIN_TOPUP_USD=0.5
MAX_TOPUP_PER_DAY_USD=2
TICK_INTERVAL_DEFAULT_SEC=300

# Local: docker compose up -d. Cloud (recommended for live demo): Neon free tier, use the pooled
# connection string (host contains "-pooler", append ?sslmode=require). Empty = embedded PGlite (single process only).
DATABASE_URL=postgres://arena:arena@localhost:5432/arena
DB_POOL_MAX=10                  # use 1-3 for serverless web deploys
DEFINITIVE_API_KEY=
ZG_API_KEY=
ZG_ROUTER_URL=
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
TELEGRAM_BOT_TOKEN=
# Dev-only agent signer (paper/testing). Production agents use server wallets.
DEV_AGENT_PRIVATE_KEY=
