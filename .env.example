# Copy to .env (git-ignored) and fill in real values. Every key is listed, so an empty value means "not set".
# The worker drops blank values and applies its defaults. The web app does not: fill numbers and enums in.
# Keep CHAIN (worker) and NEXT_PUBLIC_CHAIN (web) equal: both baseSepolia on testnet, both base on mainnet.

# ---- Platform (read by the worker and the web app) -----------------------------------------------
EXECUTION_MODE=paper                # paper | live. Live also needs the agent in live mode, the kill switch off, and DEFINITIVE_API_KEY.
NETWORK=testnet                     # testnet (Base Sepolia, 0G Galileo) | mainnet (Base, 0G). Sets 0G router defaults and BaseScan links.
GLOBAL_KILL_SWITCH=false            # true stops new orders and cancels pending entries.
MAX_TRADE_USD=1                     # per order
MIN_ORDER_USD=0.1                   # smallest order the safety rules allow; below it fixed per-fill costs dominate
MAX_AGENT_ALLOCATION_USD=5          # per agent; also the USDC allowance cap to AgentTreasury
MAX_DAILY_VOLUME_USD_PER_AGENT=20
MAX_DAILY_LOSS_USD_PER_AGENT=1
MAX_OPEN_POSITIONS=2
ALLOWED_TOKENS=WETH,cbBTC,AERO,VIRTUAL,DEGEN,TOSHI,WELL,ZORA,cbETH,MORPHO,LINK,UNI,COMP,SNX,cbDOGE,cbXRP,PRIME,KAITO,cbLTC  # comma list; Flash trades these on Base mainnet. Only WETH has a Base Sepolia feed
FLASH_INTEGRATOR_FEE_BPS=10
COMMISSION_BPS_DEFAULT=1000         # 10% of profit above the high-water mark
COMMISSION_BPS_MIN=0                # bounds for commission changes
COMMISSION_BPS_MAX=2000
AGENT_DAILY_0G_CAP=1                # per-agent 0G key credit limit (0G units, daily reset)
RESERVE_DAYS=3
MIN_TOPUP_USD=0.5
MAX_TOPUP_PER_DAY_USD=2
RELAYER_SPREAD_BPS=100              # spread on USDC to 0G conversion
TICK_INTERVAL_DEFAULT_SEC=300       # seed-demo agents only

# Chain RPCs. Use private endpoints for the demo: the public ones rate-limit.
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# ---- Database --------------------------------------------------------------------------------------
# Local: docker compose up -d. Cloud: a Neon pooled URL (host contains "-pooler", append ?sslmode=require).
# Empty DATABASE_URL uses embedded PGlite (one process only).
DATABASE_URL=postgres://arena:arena@localhost:5432/arena
DB_POOL_MAX=10                      # 1-3 for serverless web deploys
DB_POOLED=                          # true only for a pooled host without "-pooler" (e.g. PgBouncer transaction mode)
PGLITE_DIR=                         # PGlite directory when DATABASE_URL is empty (default <repo>/.pglite)

# ---- Chain selection (worker) ----------------------------------------------------------------------
CHAIN=baseSepolia                   # base | baseSepolia. Must match NEXT_PUBLIC_CHAIN.
WORKER_MAX_CONCURRENCY=3

# ---- Definitive Flash -------------------------------------------------------------------------------
DEFINITIVE_API_KEY=                 # integrator key. Needed for quotes, orders, cancels and stop changes.

# ---- 0G (Private Computer, Router, Storage, Payment Layer) -----------------------------------------
ZG_API_KEY=                         # platform router key (decisions, digests, reflections)
ZG_ROUTER_URL=                      # blank = router for NETWORK
ZG_MGMT_KEY=                        # mk-... management key: real balances and per-agent capped keys
AGENT_KEY_ENCRYPTION_KEY=           # 32 bytes of hex (openssl rand -hex 32). Encrypts per-agent 0G keys at rest.
AGENT_SEED_CREDIT_0G=1              # bootstrap credit per agent when there is no ZG_MGMT_KEY (disclose it)
ZG_PER_USDC=                        # fallback 0G per USDC when CoinGecko has no 0G price
ZG_RPC_URL=                         # 0G chain RPC for Storage and the Payment Layer deposit
ZG_STORAGE_INDEXER=                 # 0G Storage indexer. Storage is used only when this, ZG_RPC_URL and ZG_PRIVATE_KEY are set.
ZG_PRIVATE_KEY=                     # 0x + 64 hex. Storage uploads.
INSIGHT_RSS_FEEDS=                  # comma list of http(s) feeds. Blank = built-in list.

# Relayer (worker "relayer" command)
RELAYER_ZG_PRIVATE_KEY=             # 0x + 64 hex. Pays Payment Layer deposits from its 0G float.
RELAYER_MAX_REQUEST_USD=2           # a TopUpRequested above this is not converted
RELAYER_POLL_SEC=15
RELAYER_CURSOR_FILE=.relayer-cursor.json

# ---- Wallets (worker) -------------------------------------------------------------------------------
# local: keys from DEV_AGENT_* (dev and paper only). privy: Privy server wallets with policies (production).
WALLET_PROVIDER=local
# Dev only. Hold funds: use fresh keys and tiny balances. The mnemonic wins over the private key.
DEV_AGENT_MNEMONIC=
DEV_AGENT_PRIVATE_KEY=              # 0x + 64 hex. One shared trading key for every dev agent.
# Privy (WALLET_PROVIDER=privy). Setup and the policy to create: docs/SETUP.md section 6.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_AUTHORIZATION_KEY=            # base64 PKCS8 P-256 private key. Owns new agent wallets and signs wallet calls.
PRIVY_POLICY_ID=                    # policy attached to each new agent wallet
# Platform keys (provisioning and treasury)
OPERATOR_PRIVATE_KEY=               # 0x + 64 hex. Treasury topUp and collectCommission, AgentRegistry.updateConfig. Needs Base ETH.
PLATFORM_ADMIN_PRIVATE_KEY=         # 0x + 64 hex. AgentRegistry.register (the platform role). Needs Base ETH.

# ---- Onchain addresses (worker) --------------------------------------------------------------------
# From the contract deploy (docs/SETUP.md section 7). Blank = that feature is skipped.
REGISTRY_ADDRESS=                   # AgentRegistry
TREASURY_ADDRESS=                   # AgentTreasury
PERF_REGISTRY_ADDRESS=              # PerformanceRegistry
RISK_ORACLE_ADDRESS=                # RiskOracle
PERF_REGISTRY_FROM_BLOCK=0          # first block scanned for PerformanceReported logs
LOG_CHUNK_BLOCKS=2000               # blocks per eth_getLogs call

# ---- Web app (apps/web) ----------------------------------------------------------------------------
SESSION_SECRET=                     # 32+ characters (openssl rand -hex 32). Blank disables sign-in.
NEXT_PUBLIC_CHAIN=baseSepolia       # baseSepolia | base. Must match CHAIN.
NEXT_PUBLIC_WC_PROJECT_ID=          # WalletConnect Cloud project id. Blank uses a placeholder.
NEXT_PUBLIC_MARKETPLACE_ADDRESS=    # StrategyMarketplace, from deploy
NEXT_PUBLIC_TREASURY_ADDRESS=       # AgentTreasury, from deploy (same as TREASURY_ADDRESS)
NEXT_PUBLIC_USDC_ADDRESS=           # blank = native USDC for the chain
NEXT_PUBLIC_BASE_EXPLORER=https://sepolia.basescan.org
NEXT_PUBLIC_TELEGRAM_BOT=           # bot username without "@"

# ---- Telegram bot (apps/telegram) ------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=                 # from @BotFather. Blank: the bot exits without running.
WEB_URL=http://localhost:3000
BASESCAN_URL=                       # blank = derived from NETWORK
ZG_EXPLORER_URL=                    # 0G explorer base URL for transaction links
TG_STATE_FILE=                      # blank = ./.telegram-state.json

# ---- Read by other tools, not by the worker or the web app -----------------------------------------
# CRE (cre/.env, read by the CRE CLI). WF1 and WF2 read FLASH_API_KEY and ZG_API_KEY through cre/secrets.yaml.
CRE_ETH_PRIVATE_KEY=                # Base Sepolia writes with --broadcast. Use a dedicated key.
# Foundry (export in the shell that runs forge; see docs/SETUP.md section 7)
USDC_ADDRESS=
CRE_FORWARDER=
RELAYER_ADDRESS=
PLATFORM_TREASURY=
PLATFORM_BPS=3000
DEFAULT_DAILY_TOPUP_CAP_USD6=2000000
RESERVE_FLOOR_USD6=0
BASESCAN_API_KEY=                   # contract verification

# ---- Paper demo -------------------------------------------------------------------------------
DEMO_CONTROLS=false                 # true = web shows the Demo menu (simulate crash / caution / clear)
DEMO_TICK_INTERVAL_SEC=             # e.g. 60: override every paper agent's tick interval for demos
PAPER_MIN_TOPUP_USD=0.01            # paper commission balance needed before a simulated 0G top-up
