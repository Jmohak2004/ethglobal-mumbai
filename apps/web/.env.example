# Copy to apps/web/.env.local. Public values only (NEXT_PUBLIC_*).
# WalletConnect Cloud project id. Falls back to a placeholder, so wallet modal works but WC relay may be rate-limited.
NEXT_PUBLIC_WC_PROJECT_ID=
# Block explorer used for tx / address links (mainnet default).
NEXT_PUBLIC_BASE_EXPLORER=https://basescan.org
# Telegram bot handle shown on the portfolio page.
NEXT_PUBLIC_TELEGRAM_BOT=arena_demo_bot
