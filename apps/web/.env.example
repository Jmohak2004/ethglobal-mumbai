# Copy to apps/web/.env.local (or the monorepo root .env, which next.config.ts loads). Public values only here.
# NEXT_PUBLIC_* values are inlined into the browser bundle. Never put secrets in a NEXT_PUBLIC_ variable.

# WalletConnect Cloud project id. Falls back to a placeholder, so wallet modal works but WC relay may be rate-limited.
NEXT_PUBLIC_WC_PROJECT_ID=
# Block explorer used for tx / address links (mainnet default).
NEXT_PUBLIC_BASE_EXPLORER=https://basescan.org
# Telegram bot handle shown on the portfolio page.
NEXT_PUBLIC_TELEGRAM_BOT=arena_demo_bot

# Chain for trading, fork, fund and withdraw: base (default) or baseSepolia.
NEXT_PUBLIC_CHAIN=base
# Deployed contracts. Leave empty to show "contracts not deployed" in the buttons.
NEXT_PUBLIC_MARKETPLACE_ADDRESS=
NEXT_PUBLIC_TREASURY_ADDRESS=
# Defaults to native USDC on the chosen chain when empty.
NEXT_PUBLIC_USDC_ADDRESS=

# Server-only (put these in the monorepo root .env, never in NEXT_PUBLIC_*):
#   DATABASE_URL       Postgres. Unset = mock data (logged once).
#   SESSION_SECRET     At least 32 chars. Signs the wallet session cookie. Unset = sign-in disabled.
#   DEFINITIVE_API_KEY Flash key. With EXECUTION_MODE=live it enables real orders; otherwise quote-only paper mode.
#   ZG_API_KEY         Platform 0G key for AI features (platform spend requires sign-in).
#   EXECUTION_MODE     paper (default) | live.
