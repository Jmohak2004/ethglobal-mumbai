# Copy to cre/.env (git-ignored). Never commit real values.
# Private key used by `cre workflow simulate --broadcast` to submit the write transaction (needs Base Sepolia ETH).
CRE_ETH_PRIVATE_KEY=
# Read-only Definitive Flash key (integrator auth; cannot move funds).
FLASH_API_KEY=
# 0G Router key (WF2 LLM signal only, optional).
ZG_API_KEY=
